<?xml version="1.0" encoding="UTF-8"?>
<VAST version="4.3" xmlns="http://www.iab.com/VAST">
  <Ad id="in">
    <InLine>
      <AdSystem>harness</AdSystem>
      <Error><![CDATA[{{BASE}}/t/{{CASE}}/in/err?code=[ERRORCODE]]]></Error>
      <Impression id="in"><![CDATA[{{BASE}}/t/{{CASE}}/in/imp]]></Impression>
      <AdServingId>in-serving</AdServingId>
      <AdTitle>in</AdTitle>
      <Creatives>
        <Creative id="in-c" adId="in-c">
          <Linear>
            <Icons>
              <Icon program="AdChoices" width="20" height="20" xPosition="left" yPosition="top">
                <StaticResource creativeType="image/gif"><![CDATA[{{BASE}}/t/{{CASE}}/in/icon-img]]></StaticResource>
                <IconClicks>
                  <IconClickThrough><![CDATA[{{BASE}}/t/{{CASE}}/in/icon-clickthrough]]></IconClickThrough>
                  <IconClickTracking><![CDATA[{{BASE}}/t/{{CASE}}/in/icon-click]]></IconClickTracking>
                </IconClicks>
                <IconViewTracking><![CDATA[{{BASE}}/t/{{CASE}}/in/icon-view]]></IconViewTracking>
              </Icon>
            </Icons>
            <TrackingEvents>
        <Tracking event="start"><![CDATA[{{BASE}}/t/{{CASE}}/in/start]]></Tracking>
        <Tracking event="firstQuartile"><![CDATA[{{BASE}}/t/{{CASE}}/in/firstQuartile]]></Tracking>
        <Tracking event="midpoint"><![CDATA[{{BASE}}/t/{{CASE}}/in/midpoint]]></Tracking>
        <Tracking event="thirdQuartile"><![CDATA[{{BASE}}/t/{{CASE}}/in/thirdQuartile]]></Tracking>
        <Tracking event="complete"><![CDATA[{{BASE}}/t/{{CASE}}/in/complete]]></Tracking>
            </TrackingEvents>
            <Duration>00:00:10</Duration>
            <MediaFiles>
              <MediaFile delivery="progressive" type="video/webm" width="640" height="360"><![CDATA[{{BASE}}/media/ad-10s.webm?case={{CASE}}&ad=in]]></MediaFile>
              <MediaFile delivery="progressive" type="video/mp4" width="640" height="360"><![CDATA[{{BASE}}/media/ad-10s.mp4?case={{CASE}}&ad=in]]></MediaFile>
            </MediaFiles>
            <VideoClicks>
              <ClickTracking><![CDATA[{{BASE}}/t/{{CASE}}/in/clicktracking]]></ClickTracking>
              <ClickThrough><![CDATA[{{BASE}}/t/{{CASE}}/in/clickthrough]]></ClickThrough>
            </VideoClicks>
          </Linear>
          <UniversalAdId idRegistry="unknown">unknown</UniversalAdId>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
